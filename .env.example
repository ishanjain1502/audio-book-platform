COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
FISH_API_KEY=
FISH_BASE_URL=https://api.fish.audio
FISH_FALLBACK_MODEL=s2.1-pro
DATA_DIR=./src/data

# Cloudflare R2. This project uses the media-assets bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=media-assets
STORAGE_BACKEND=r2

# Neatlogs tracing (https://ingest.neatlogs.com)
NEATLOGS_API_KEY=
