{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug job worker",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run-job.ts",
      "args": ["${input:jobId}"],
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug job 11 (reference audio failure)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run-job.ts",
      "args": ["11"],
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "inputs": [
    {
      "id": "jobId",
      "type": "promptString",
      "description": "Job ID (folder under src/data/jobs/)",
      "default": "11"
    }
  ]
}
